# ============================================================
# Calligraphy JOUD — environment (copy to .env.local and fill in)
# ALL of these are server-side only. Never prefix with NEXT_PUBLIC_.
# The consumer key/secret are never exposed to the browser bundle.
# Restart the dev/prod server after changing this file. Never commit .env.local.
# ============================================================

# --- WooCommerce REST API (required for the live store) ---
# Generate in WordPress admin: WooCommerce > Settings > Advanced > REST API > Add key
#   Permissions: Read/Write   |   API version: v3
# WOO_STORE_URL with or without a trailing slash; the client appends /wp-json/wc/v3.
# Must be HTTPS in production. Set Permalinks to "Post name" or the REST API 404s.
WOO_STORE_URL=https://your-store-domain.com
WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- WhatsApp number for fallbacks / quick contact ---
# Country code + digits only, no "+". Defaults to 212600000000 if unset.
WA_NUMBER=212600000000

# --- "Never lose an order" fallbacks (optional) ---
# If WooCommerce is unreachable when an order is placed, the order is still
# captured through these channels (and the customer is routed to WhatsApp).
# 1) Google Sheet via a Google Apps Script web-app URL that accepts POST JSON:
ORDERS_FALLBACK_SHEET_URL=
# 2) Email notification via Resend (https://resend.com):
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=you@example.com
# Optional "from" address (must be a verified Resend domain); defaults to orders@calligraphyjoud.com
ORDER_FROM_EMAIL=

# --- Facebook / Meta Ads (optional; the Pixel + CAPI are no-ops until set) ---
# Pixel ID is public (appears in the browser). Find it in Meta Events Manager.
NEXT_PUBLIC_FB_PIXEL_ID=
# Conversions API access token (SECRET — server-side only). Events Manager > Settings > Conversions API.
FB_CAPI_TOKEN=
# Optional: same pixel id for server-side CAPI (defaults to NEXT_PUBLIC_FB_PIXEL_ID).
FB_PIXEL_ID=

# --- Admin board protection (set to enable the password gate on /admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=
